{
  "name": "@jumplink/site",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "jumplink.eu: Pascal Garber's apps, blog and CV",
  "author": "Pascal Garber",
  "license": "MIT",
  "scripts": {
    "build": "gjsify site build --out _site && cp -r static/. _site/",
    "build:drafts": "gjsify site build --out _site --drafts && cp -r static/. _site/",
    "i18n": "gjsify site i18n"
  },
  "devDependencies": {
    "@gjsify/cli": "0.64.11",
    "@gjsify/site": "0.64.11"
  },
  "gjsify": {
    "site": {
      "url": "https://jumplink.eu/",
      "languages": ["en", "de"],
      "defaultLanguage": "en",
      "repository": "JumpLink/jumplink.github.io",
      "developer": {
        "resume": {
          "en": "content/resume.en.json",
          "de": "content/resume.de.json"
        },
        "apps": [
          "https://jumplink.eu/beifahrer/",
          "https://jumplink.eu/steuererklaerung/",
          "https://jumplink.eu/Learn6502/"
        ]
      },
      "blog": { "posts": "blog" },
      "theme": {
        "accent": { "light": "#1c7a4a", "dark": "#57e389" },
        "displayFont": "assets/fonts/ark-pixel-16px-proportional-latin.woff2",
        "imageRendering": "pixelated"
      },
      "support": [
        { "kind": "GitHub Sponsors", "url": "https://github.com/sponsors/JumpLink" },
        { "kind": "Liberapay", "url": "https://liberapay.com/JumpLink" },
        { "kind": "PayPal", "url": "https://paypal.me/JumpLink" },
        { "kind": "sepa", "name": "JumpLink - Pascal Garber", "iban": "DE94100101232090324020" }
      ],
      "privacy": {
        "statements": { "en": "content/privacy.en.md", "de": "content/privacy.de.md" },
        "hostingPolicyUrl": "https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement"
      },
      "legalNotice": {
        "statements": { "en": "content/legal-notice.en.md", "de": "content/legal-notice.de.md" }
      }
    }
  }
}
